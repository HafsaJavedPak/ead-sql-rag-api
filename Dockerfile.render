FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY ead_agent ./ead_agent
COPY ead_api ./ead_api
COPY migrations ./migrations
COPY alembic.ini ./

# API-only image for free-tier hosting: no ead_ui, and no `[local]` extra
# (sentence-transformers/torch). This only works with EMBED_PROVIDER=lexical,
# which never imports an embedding model (see ead_agent/llm.py:get_embeddings) --
# that keeps the image and runtime memory small enough for a free web-service
# instance. Use the root Dockerfile instead if you need EMBED_PROVIDER=huggingface
# or the Gradio console.
RUN pip install --upgrade pip \
    && pip install .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/artifacts /app/.cache \
    && chown -R appuser:appuser /app

USER appuser
EXPOSE 8000

# Render injects $PORT at runtime; fall back to 8000 for local `docker run`.
CMD ["sh", "-c", "alembic upgrade head && uvicorn ead_api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
