# Secrets — never commit. .env holds a live model-provider API key.
.env
.env.*
!.env.example
!.env.production.example
!.env.render.example
!.env.spaces.example

# Scratch credential dumps (e.g. Aiven service info/CA cert copied locally
# while preparing a deploy) — never commit these either.
ca.pem
keys
my-keys

# Virtualenv and build artifacts
.venv/
*.egg-info/
build/
dist/

# Generated local data (rebuild with scripts/build_dummy_sqlite.py)
.local/

# Generated caches (rebuild with scripts/catalog_cli.py --rebuild)
.cache/

# Runtime output
artifacts/
charts_out/

# Generated by the ead_web static-site deploy (Render Static Site build
# command); absent in local dev on purpose (see ead_web/index.html).
ead_web/config.js

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# macOS zip residue
__MACOSX/
