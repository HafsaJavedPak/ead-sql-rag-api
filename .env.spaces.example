# Reference values for deploying ead-sql-rag-api to a Hugging Face Space
# (Docker SDK), with PostgreSQL on Neon and analytics MySQL on Aiven's free
# tier -- both external. See docs/deploy-huggingface-spaces.md for the full
# walkthrough.
#
# This file is a local planning aid -- Spaces does not read it. Set the real
# values with `hf spaces secrets add` / `hf spaces variables add`, or in the
# Space's Settings tab. Never put real secrets in this file.
#
# Split matches Spaces' own model: Secrets are write-only/hidden, Variables
# are plain. Anything below marked (secret) should go through
# `hf spaces secrets add`; everything else through `hf spaces variables add`.

# --- Core app posture ---
APP_ENV=production
DOCS_ENABLED=false
AUTO_CREATE_SCHEMA=false
LOG_LEVEL=INFO

# Dockerfile.spaces listens on a fixed 8000, matching `app_port: 8000` in
# the Space's README.md frontmatter (README.spaces.md) -- there's no dynamic
# $PORT to read here the way Render injects one.

# Your Space's public hostname, e.g. YOUR_USERNAME-ead-sql-rag-api.hf.space.
# No wildcards -- APP_ENV=production rejects "*" in either list. If you see
# a TrustedHost 400 after first deploy, check the Space's logs for the Host
# header it actually received and adjust this to match.
ALLOWED_HOSTS=YOUR_USERNAME-ead-sql-rag-api.hf.space
CORS_ORIGINS=https://your-web-console.example

# Generate with: openssl rand -base64 64   (secret)
JWT_SECRET_KEY=

# --- Application PostgreSQL (Neon free tier) -- stays external for real
# persistence. Same URL-shape split as the Render path: asyncpg wants
# "postgresql+asyncpg://" + "?ssl=require"; the langgraph checkpointer
# (psycopg) wants "postgresql://" + "?sslmode=require". (both secret)
APP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx.c-4.us-east-2.tech/neondb?ssl=require
LANGGRAPH_DATABASE_URL=postgresql://USER:PASSOWRD@ep-xxx.neon.tech/neondb?sslmode=require

# --- Analytics MySQL: Aiven free tier (1GB, dedicated service) ---
# Aiven gives you a host like mysql-xxxx.f.aivencloud.com, a port, the
# default admin user "avnadmin", and ONE pre-created database -- commonly
# named "defaultdb", not "ead_db". Use the exact name Aiven shows you.
#
# Two accounts, on purpose: avnadmin (DB_USER) only ever does schema
# introspection (ead_agent/db.py:admin_engine). Aiven services are dedicated
# per-account, so avnadmin can create the second, SELECT-only account
# directly via SQL:
#   CREATE USER 'ead_ro'@'%' IDENTIFIED BY 'a-strong-generated-password';
#   GRANT SELECT ON `defaultdb`.* TO 'ead_ro'@'%';
# That second account is the ONLY credential that ever executes generated
# SQL (ead_agent/db.py:readonly_engine). (both passwords are secret)
DB_HOST=mysql-xxxx.f.aivencloud.com
DB_PORT=
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=                      # (secret)
DB_READONLY_USER=ead_ro
DB_READONLY_PASSWORD=             # (secret)
# Do NOT set ANALYTICS_DATABASE_URL -- ead_agent/db.py uses it for BOTH the
# admin and read-only engines regardless of which credentials you pass,
# which collapses this separation.

# Aiven enforces TLS on every connection. Paste the FULL PEM content of the
# CA certificate from Aiven's console for this service (not a file path).
# (secret)
DB_SSL_CA=

# --- LLM: Groq (free, OpenAI-compatible, already the default provider) ---
LLM_PROVIDER=groq
GROQ_API_KEY=                     # (secret)

# --- Embeddings: lexical = no model loaded, required by this image ---
EMBED_PROVIDER=lexical

# --- Langfuse Cloud (free Hobby tier) -- stays external; self-hosting it is
# the heaviest thing in the whole stack and gains nothing bundled here.
# APP_ENV=production requires LANGFUSE_ENABLED=true
# (ead_api/core/config.py Settings.validate_production).
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=              # (secret)
LANGFUSE_SECRET_KEY=              # (secret)
# Use https://us.cloud.langfuse.com if your project is in the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TRACING_ENVIRONMENT=production
