# Reference values for deploying ead-sql-rag-api to Render on free-tier
# external services. See docs/deploy-render.md for the full walkthrough and
# render.yaml for the Blueprint that reads these same keys.
#
# This file is a local planning aid -- Render does not read it. Paste the
# real values into the Render dashboard (or `render env:set`) after the
# Blueprint creates the service. Never put real secrets in this file.

# --- Core app posture ---
APP_ENV=production
DOCS_ENABLED=false
AUTO_CREATE_SCHEMA=false
LOG_LEVEL=INFO

# Your Render service hostname and the origin(s) of whatever calls this API.
# No wildcards -- APP_ENV=production rejects "*" in either list.
ALLOWED_HOSTS=ead-sql-rag-api.onrender.com
CORS_ORIGINS=https://your-web-console.example

# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=

# --- Application PostgreSQL (Neon free tier) ---
# Neon gives you one connection string like:
#   postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
# Rewrite it per consumer -- these are TWO different client libraries against
# the SAME database, and each wants its SSL flag spelled differently:
#   APP_DATABASE_URL uses SQLAlchemy's asyncpg driver -> scheme
#     "postgresql+asyncpg://" and "?ssl=require" (not "sslmode").
#   LANGGRAPH_DATABASE_URL is read directly by the langgraph Postgres
#     checkpointer (psycopg) -> keep Neon's string close to as-is, with
#     "?sslmode=require".
APP_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.neon.tech/neondb?ssl=require
LANGGRAPH_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require

# --- Analytics MySQL: Aiven free tier (1GB, dedicated service) ---
# Aiven gives you a host like mysql-xxxx.f.aivencloud.com, a port, the
# default admin user "avnadmin", and ONE pre-created database -- commonly
# named "defaultdb", not "ead_db". Use the exact name Aiven shows you.
#
# Two accounts, on purpose: avnadmin (DB_USER) only ever does schema
# introspection (ead_agent/db.py:admin_engine) -- never runs model-generated
# SQL. Aiven services are dedicated per-account, so avnadmin can create the
# second, SELECT-only account directly:
#   CREATE USER 'ead_ro'@'%' IDENTIFIED BY 'a-strong-generated-password';
#   GRANT SELECT ON `defaultdb`.* TO 'ead_ro'@'%';
# That second account (DB_READONLY_USER/DB_READONLY_PASSWORD) is the ONLY
# credential that ever executes generated SQL (ead_agent/db.py:readonly_engine).
# Do NOT set ANALYTICS_DATABASE_URL -- it overrides both engines with the
# same credential and defeats this separation (ead_agent/db.py:33-34).
DB_HOST=mysql-xxxx.f.aivencloud.com
DB_PORT=
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_READONLY_USER=ead_ro
DB_READONLY_PASSWORD=

# Aiven enforces TLS on every connection. Paste the FULL PEM content of the
# CA certificate from Aiven's console for this service (not a file path) --
# ead_agent/db.py writes it to a local file at startup and hands PyMySQL
# that path. Required for Aiven; leave empty only for a MySQL host that
# doesn't enforce TLS.
DB_SSL_CA=

# --- LLM: Groq (free, OpenAI-compatible, already the default provider) ---
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Embeddings: lexical = no model loaded, required by Dockerfile.render ---
EMBED_PROVIDER=lexical

# --- Langfuse Cloud (free Hobby tier) ---
# APP_ENV=production requires LANGFUSE_ENABLED=true -- there is no supported
# way to skip this while running with production hardening (see
# ead_api/core/config.py Settings.validate_production).
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use https://us.cloud.langfuse.com if your project is in the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_TRACING_ENVIRONMENT=production
